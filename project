  <!-- Embedded Custom Micro-Interactions & Animations -->
  <style>
    /* Subtle float animation for hero graphic */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    .animate-float {
      animation: floatSlow 5s ease-in-out infinite;
    }

    /* Animated water flow dashes in SVG pipes */
    @keyframes dashFlow {
      to { stroke-dashoffset: -24; }
    }
    .water-flow-line {
      stroke-dasharray: 6 6;
      animation: dashFlow 1.2s linear infinite;
    }

    /* Badge pop animation when cart updates */
    @keyframes popScale {
      0% { transform: scale(1); }
      50% { transform: scale(1.35); }
      100% { transform: scale(1); }
    }
    .animate-pop {
      animation: popScale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Smooth accordion content transition */
    .accordion-content {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.28s ease-out;
    }
    .accordion-item[data-open="true"] .accordion-content {
      grid-template-rows: 1fr;
    }
    .accordion-inner {
      overflow: hidden;
    }

    /* Toast slide-in animation */
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(16px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .toast-enter {
      animation: toastIn 0.25s ease-out forwards;
    }

    /* Custom subtle scrollbar */
