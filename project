      ------------------------------------------------------------------- */
      function getCartTotals() {
        const itemCount = state.cart.reduce((sum, item) => sum + item.qty, 0);
        const subtotal = state.cart.reduce((sum, item) => sum + item.price * item.qty, 0);
        const discount = state.promo ? subtotal * state.promo.rate : 0;
        const discountedSubtotal = Math.max(0, subtotal - discount);
        const shipping = itemCount === 0 ? 0 : (subtotal >= FREE_SHIPPING_THRESHOLD ? 0 : FLAT_SHIPPING_COST);
        const total = discountedSubtotal + shipping;
        return { itemCount, subtotal, discount, shipping, total };
      }

      function addToCart(productId) {
        const product = PRODUCTS.find(p => p.id === Number(productId));
        if (!product) return;

        const existing = state.cart.find(item => item.id === product.id);
        if (existing) {
          existing.qty += 1;
        } else {
          state.cart.push({
            id: product.id,
            name: product.name,
            price: product.price,
            stageTag: product.stageTag,
            svgType: product.svgType,
            qty: 1
          });
        }

        renderCart();
        // Animate cart count badge
        el.cartCountBadge.classList.remove('animate-pop');
        void el.cartCountBadge.offsetWidth;
        el.cartCountBadge.classList.add('animate-pop');

        showToast(`Added "${product.name}" to cart`);
      }

      function updateCartQty(productId, delta) {
        const idx = state.cart.findIndex(item => item.id === Number(productId));
        if (idx === -1) return;

        state.cart[idx].qty += delta;
        if (state.cart[idx].qty <= 0) {
          state.cart.splice(idx, 1);
        }
        renderCart();
      }

      function removeCartItem(productId) {
        state.cart = state.cart.filter(item => item.id !== Number(productId));
        renderCart();
        showToast('Item removed from cart', 'info');
      }

      function renderCart() {
        const { itemCount, subtotal, discount, shipping, total } = getCartTotals();

        el.cartCountBadge.textContent = itemCount;
        el.cartDrawerSubtitle.textContent = `${itemCount} ${itemCount === 1 ? 'item' : 'items'} selected`;

        // Free shipping progress bar
        const progressPct = Math.min(100, (subtotal / FREE_SHIPPING_THRESHOLD) * 100);
        el.shippingProgressBar.style.width = `${progressPct}%`;
        if (subtotal >= FREE_SHIPPING_THRESHOLD) {
          el.shippingProgressText.innerHTML = `<span class="text-emerald-700">✓ Congrats! You unlocked FREE Express Shipping!</span>`;
        } else {
          const remaining = FREE_SHIPPING_THRESHOLD - subtotal;
          el.shippingProgressText.textContent = `Add ${formatMoney(remaining)} more for FREE shipping`;
        }

        // Cart items list
        if (state.cart.length === 0) {
          el.cartItemsContainer.innerHTML = `
            <div class="h-full flex flex-col items-center justify-center text-center py-12">
              <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mb-4">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </div>
              <p class="font-bold text-navy-900">Your cart is empty</p>
              <p class="text-xs text-slate-500 mt-1 max-w-xs">Explore our NSF-certified water filtration systems and add your favorite to get started.</p>
            </div>
          `;
        } else {
          el.cartItemsContainer.innerHTML = state.cart.map(item => `
            <div class="flex gap-3.5 p-3.5 rounded-2xl border border-slate-200 bg-white">
              <div class="w-16 h-16 rounded-xl bg-slate-50 p-1.5 shrink-0 flex items-center justify-center">
                ${getProductSVG(item.svgType)}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-sm font-bold text-navy-900 leading-tight truncate">${item.name}</h4>
                  <button type="button" data-remove-id="${item.id}" aria-label="Remove item" class="remove-item-btn text-slate-400 hover:text-rose-500 transition-colors p-0.5">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                  </button>
                </div>
                <p class="text-[11px] text-slate-500 mt-0.5">${item.stageTag}</p>
                <div class="mt-2.5 flex items-center justify-between">
                  <div class="inline-flex items-center border border-slate-200 rounded-lg overflow-hidden">
                    <button type="button" data-qty-id="${item.id}" data-delta="-1" class="qty-btn px-2.5 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100">−</button>
                    <span class="px-2.5 py-1 text-xs font-bold text-navy-900 bg-slate-50">${item.qty}</span>
                    <button type="button" data-qty-id="${item.id}" data-delta="1" class="qty-btn px-2.5 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100">+</button>
                  </div>
                  <span class="text-sm font-extrabold text-navy-900">${formatMoney(item.price * item.qty)}</span>
                </div>
              </div>
            </div>
          `).join('');
        }

        // Totals & Promo Display
        el.cartSubtotal.textContent = formatMoney(subtotal);
        if (state.promo && subtotal > 0) {
          el.cartDiscountRow.classList.remove('hidden');
          el.cartDiscountRow.classList.add('flex');
          el.cartPromoLabel.textContent = state.promo.code;
          el.cartDiscount.textContent = `-${formatMoney(discount)}`;
          el.promoStatus.innerHTML = `
            <span class="text-emerald-600 font-semibold">Promo "${state.promo.code}" applied (${state.promo.label})</span>
            <button type="button" id="remove-promo-btn" class="text-slate-400 hover:text-rose-500 underline">Remove</button>
          `;
          const removeBtn = document.getElementById('remove-promo-btn');
          if (removeBtn) {
            removeBtn.addEventListener('click', () => {
              state.promo = null;
              el.promoInput.value = '';
              el.promoStatus.innerHTML = '';
              renderCart();
              showToast('Promo code removed', 'info');
            });
          }
        } else {
          el.cartDiscountRow.classList.add('hidden');
          el.cartDiscountRow.classList.remove('flex');
        }

        el.cartShipping.textContent = itemCount === 0 ? '$0.00' : (shipping === 0 ? 'FREE' : formatMoney(shipping));
        el.cartShipping.className = shipping === 0 && itemCount > 0 ? 'font-bold text-emerald-600' : 'font-semibold text-navy-900';
        el.cartTotal.textContent = formatMoney(total);
        el.openCheckoutBtn.disabled = itemCount === 0;
      }

      function openCartDrawer() {
        el.cartOverlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          el.cartBackdrop.classList.remove('opacity-0');
          el.cartDrawer.classList.remove('translate-x-full');
        });
      }

      function closeCartDrawer() {
        el.cartBackdrop.classList.add('opacity-0');
        el.cartDrawer.classList.add('translate-x-full');
        setTimeout(() => {
          el.cartOverlay.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      /* -------------------------------------------------------------------
         13. SIMULATED CHECKOUT MODAL
      ------------------------------------------------------------------- */
      function openCheckoutModal() {
        const { itemCount, total } = getCartTotals();
        if (itemCount === 0) return;

        closeCartDrawer();
        el.coItemCount.textContent = `${itemCount} ${itemCount === 1 ? 'item' : 'items'}`;
        el.coTotal.textContent = formatMoney(total);

        el.checkoutFormView.classList.remove('hidden');
        el.checkoutConfirmView.classList.add('hidden');
        el.checkoutModal.classList.remove('hidden');
        el.checkoutModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeCheckoutModal() {
        el.checkoutModal.classList.add('hidden');
        el.checkoutModal.classList.remove('flex');
        document.body.style.overflow = '';
      }

      /* -------------------------------------------------------------------
         14. EVENT LISTENERS
      ------------------------------------------------------------------- */
      function initEvents() {
        // Mobile Menu Toggle
        el.mobileMenuBtn.addEventListener('click', () => {
          el.mobileMenu.classList.toggle('hidden');
        });
        document.querySelectorAll('.mobile-nav-link').forEach(link => {
          link.addEventListener('click', () => el.mobileMenu.classList.add('hidden'));
        });

        // Live Header Search
        el.headerSearch.addEventListener('input', (e) => {
          state.search = e.target.value;
          renderProducts();
        });
        el.headerSearch.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            document.getElementById('shop').scrollIntoView({ behavior: 'smooth' });
          }
        });

        // Category Filter Pills (delegated)
        el.categoryPills.addEventListener('click', (e) => {
          const btn = e.target.closest('.category-pill');
          if (!btn) return;
          state.category = btn.dataset.category;
          renderCategoryPills();
          renderProducts();
        });

        // Sort Dropdown
        el.sortSelect.addEventListener('change', (e) => {
          state.sort = e.target.value;
          renderProducts();
        });

        // Reset Filters
        el.resetFiltersBtn.addEventListener('click', () => {
          state.category = 'All';
          state.search = '';
          state.sort = 'featured';
          el.headerSearch.value = '';
          el.sortSelect.value = 'featured';
          renderCategoryPills();
          renderProducts();
        });

        // Product Grid Actions (Quick View & Add to Cart)
        el.productGrid.addEventListener('click', (e) => {
          const qvBtn = e.target.closest('.quick-view-btn');
          if (qvBtn) {
            openQuickView(qvBtn.dataset.quickView);
            return;
          }
          const addBtn = e.target.closest('.add-to-cart-btn');
          if (addBtn) {
            addToCart(addBtn.dataset.addCart);
          }
        });

        // Comparison Table Quick Add Buttons
        document.querySelectorAll('.compare-add-btn').forEach(btn => {
          btn.addEventListener('click', () => addToCart(btn.dataset.compareAdd));
        });

        // Quick-View Modal Close
        el.closeQvBtn.addEventListener('click', closeQuickView);
        el.quickViewModal.addEventListener('click', (e) => {
          if (e.target === el.quickViewModal) closeQuickView();
        });

        // 5-Stage Filtration Explorer
        el.stageButtons.addEventListener('click', (e) => {
          const btn = e.target.closest('.stage-btn');
          if (!btn) return;
          state.activeStage = Number(btn.dataset.stage);
          renderFiltrationExplorer();
        });

        // FAQ Accordion
        el.faqAccordion.addEventListener('click', (e) => {
          const trigger = e.target.closest('.faq-trigger');
          if (!trigger) return;
          const item = trigger.closest('.accordion-item');
          const icon = trigger.querySelector('.faq-icon');
          const isOpen = item.getAttribute('data-open') === 'true';

          item.setAttribute('data-open', String(!isOpen));
          trigger.setAttribute('aria-expanded', String(!isOpen));
          icon.classList.toggle('rotate-45', !isOpen);
        });

        // Cart Drawer Open / Close
        el.openCartBtn.addEventListener('click', openCartDrawer);
        el.closeCartBtn.addEventListener('click', closeCartDrawer);
        el.cartBackdrop.addEventListener('click', closeCartDrawer);

        // Cart Item Qty & Remove (delegated)
        el.cartItemsContainer.addEventListener('click', (e) => {
          const qtyBtn = e.target.closest('.qty-btn');
          if (qtyBtn) {
            updateCartQty(qtyBtn.dataset.qtyId, Number(qtyBtn.dataset.delta));
            return;
          }
          const removeBtn = e.target.closest('.remove-item-btn');
          if (removeBtn) {
            removeCartItem(removeBtn.dataset.removeId);
          }
        });

        // Promo Code Form
        el.promoForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const code = el.promoInput.value.trim().toUpperCase();
          if (!code) return;

          if (VALID_PROMOS[code]) {
            state.promo = VALID_PROMOS[code];
            renderCart();
            showToast(`Promo code ${code} applied — 10% off!`);
          } else {
            el.promoStatus.innerHTML = `<span class="text-rose-500 font-medium">Invalid code. Try <strong>PURE10</strong> for 10% off.</span>`;
            showToast('Invalid promo code. Try PURE10.', 'error');
          }
        });

        // Checkout Modal Triggers
        el.openCheckoutBtn.addEventListener('click', openCheckoutModal);
        el.closeCheckoutBtn.addEventListener('click', closeCheckoutModal);
        el.continueShoppingBtn.addEventListener('click', closeCheckoutModal);
        el.checkoutModal.addEventListener('click', (e) => {
          if (e.target === el.checkoutModal) closeCheckoutModal();
        });

        // Checkout Submission
        el.checkoutForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = document.getElementById('co-name').value.trim();
          const email = document.getElementById('co-email').value.trim();
          const { total } = getCartTotals();
          const orderId = '#AQP-' + Math.floor(10000 + Math.random() * 90000);

          el.confirmCustomerName.textContent = name || 'Valued Customer';
          el.confirmCustomerEmail.textContent = email;
          el.confirmOrderId.textContent = orderId;
          el.confirmOrderTotal.textContent = formatMoney(total);

          // Reset cart after confirmation
          state.cart = [];
          state.promo = null;
          el.promoInput.value = '';
          el.promoStatus.innerHTML = '';
          renderCart();
          el.checkoutForm.reset();

          el.checkoutFormView.classList.add('hidden');
          el.checkoutConfirmView.classList.remove('hidden');
          showToast(`Order ${orderId} confirmed!`);
        });

        // Newsletter Signup Form with Validation
        el.newsletterForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = el.newsletterEmail.value.trim();
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

          if (!emailRegex.test(email)) {
            el.newsletterFeedback.textContent = 'Please enter a valid email address.';
            el.newsletterFeedback.className = 'text-xs text-rose-400 font-medium min-h-[1rem]';
            return;
          }

          el.newsletterFeedback.textContent = 'Subscribed! Check your inbox for code PURE10.';
          el.newsletterFeedback.className = 'text-xs text-emerald-400 font-medium min-h-[1rem]';
          el.newsletterEmail.value = '';
          showToast('Welcome to AquaPure! Code PURE10 unlocked.');
        });

        // Escape Key closes active modals / drawer
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeQuickView();
            closeCheckoutModal();
            if (!el.cartOverlay.classList.contains('hidden')) {
              closeCartDrawer();
            }
          }
        });
      }

      /* -------------------------------------------------------------------
         15. INITIALIZE APPLICATION
      ------------------------------------------------------------------- */
      try {
        renderCategoryPills();
        renderProducts();
        renderFiltrationExplorer();
        renderFAQs();
        renderCart();
        initEvents();
      } catch (err) {
        console.error('AquaPure initialization error:', err);
      }
    })();
  </script>
</body>
</html>
